# =============================================================
# .gitignore for a Next.js + TypeScript + Tailwind CSS portfolio
# Lines starting with "#" are comments. "!" means "do NOT ignore".
# =============================================================

# ---------- Dependencies ----------
# Downloaded packages. Recreated anytime with your package manager's install command.
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ---------- Next.js build output ----------
# Generated by the dev server and production builds.
/.next/
/out/

# ---------- Other build and deployment artifacts ----------
/build
/dist
*.tsbuildinfo
next-env.d.ts
# Vercel CLI project link and local build output
.vercel

# ---------- Testing output ----------
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# ---------- Environment files and secrets ----------
# Never commit real secrets (API keys, passwords, tokens).
.env
.env.*
# Keep the example file (variable names only, no real values) so others know what to set.
!.env.example
*.pem
*.key

# ---------- Logs ----------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# ---------- Caches ----------
.eslintcache
.cache/
.turbo

# ---------- Operating-system files ----------
# macOS
.DS_Store
._*
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# Linux
*~
.directory

# ---------- Editor-specific files ----------
# VS Code: ignore personal settings, but keep shared recommendations
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
# JetBrains (WebStorm, IntelliJ)
.idea/
# Vim / Emacs swap and backup files
*.swp
*.swo
\#*\#

# ---------- Claude Code personal files ----------
# Personal overrides only. The shared .claude/ folder and CLAUDE.md ARE committed.
.claude/settings.local.json
CLAUDE.local.md
